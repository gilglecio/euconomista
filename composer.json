{
    "name": "gilglecio/slim3-skeleton",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "slim-framework",
        "skeleton",
        "mvc"
    ],
    "authors": [
        {
            "name": "Gilglécio Santos",
            "email": "gilglecio_765@hotmail.com",
            "homepage": "http://gilglecio.com.br"
        }
    ],
    "autoload": {
        "psr-4": {
            "Domain\\": "domain",
            "App\\Controller\\": "app/src/Controllers",
            "App\\Mail\\": "app/src/Mail",
            "App\\Auth\\": "app/src/Auth",
            "App\\Interfaces\\": "app/src/Interfaces",
            "App\\Util\\": "app/src/Util",
            "App\\Infra\\": "app/src/Infra"
        },
        "classmap": [
            "app/src/models"
        ]
    },
    "require": {
        "php": "^8.2",
        "slim/slim": "^3.12",
        "slim/twig-view": "^2.5.1",
        "twig/twig": "^3.21",
        "slim/flash": "^0.4",
        "monolog/monolog": "^2.9",
        "zamzar/php-activerecord": "^1.7.1",
        "phpmailer/phpmailer": "^6.9",
        "doctrine/dbal": "^3.9",
        "doctrine/migrations": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    }
}
